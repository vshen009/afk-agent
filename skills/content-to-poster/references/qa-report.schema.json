{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/content-to-poster/qa-report.schema.json",
  "title": "Content to Poster QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "overall_status", "manifest_path", "pages", "notes"],
  "properties": {
    "version": { "const": 1 },
    "overall_status": { "type": "string", "enum": ["pending", "pass", "fail"] },
    "manifest_path": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "pass", "fail"] },
        "evidence": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "location", "expected", "observed", "action"],
      "properties": {
        "category": { "type": "string", "enum": ["text_fidelity", "content_accuracy", "design_compliance", "visual_integrity"] },
        "location": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 },
        "observed": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "image_paths", "checks", "issues"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "status": { "type": "string", "enum": ["pending", "pass", "fail"] },
        "image_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text_fidelity", "content_accuracy", "design_compliance", "visual_integrity"],
          "properties": {
            "text_fidelity": { "$ref": "#/$defs/check" },
            "content_accuracy": { "$ref": "#/$defs/check" },
            "design_compliance": { "$ref": "#/$defs/check" },
            "visual_integrity": { "$ref": "#/$defs/check" }
          }
        },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    }
  }
}
