{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/content-to-poster/poster-plan.schema.json",
  "title": "Content to Poster Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "audience",
    "channel",
    "language",
    "aspect_ratio",
    "style",
    "continuity",
    "pages"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "aspect_ratio": {
      "type": "string",
      "enum": ["1:1", "3:4", "4:5", "9:16", "9:21", "16:9"]
    },
    "style": { "type": "string", "minLength": 1 },
    "continuity": { "type": "string", "minLength": 1 },
    "footer": { "type": "string" },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "type": "string" },
        "size": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "quality": { "type": "string", "enum": ["low", "medium", "high", "auto"] }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "text"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "headline", "visual_brief", "source_refs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": ["cover", "thesis", "section", "list", "steps", "comparison", "quote", "data", "cta", "summary"]
        },
        "kicker": { "type": "string" },
        "headline": { "type": "string", "minLength": 1 },
        "subheadline": { "type": "string" },
        "body": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "items": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/item" }
        },
        "quote": { "type": "string" },
        "attribution": { "type": "string" },
        "facts": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "cta": { "type": "string" },
        "footer": { "type": "string" },
        "visual_brief": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
