# Required
IMAGE2_BASE_URL=https://provider.example.com/
IMAGE2_API_KEY=replace-with-local-secret

# Common OpenAI-compatible defaults
IMAGE2_MODEL=gpt-image-2
IMAGE2_PROVIDER_NAME=image2-api
IMAGE2_AUTH_HEADER=Authorization
IMAGE2_AUTH_SCHEME=Bearer
IMAGE2_EXTRA_HEADERS_JSON={}

# Request defaults
IMAGE2_SIZE=1024x1024
IMAGE2_QUALITY=high
IMAGE2_OUTPUT_FORMAT=png
IMAGE2_RESPONSE_FORMAT=url
IMAGE2_TIMEOUT=300

# Uncomment only when the provider does not use standard Image2 paths.
# IMAGE2_GENERATE_ENDPOINT=https://provider.example.com/custom/generations
# IMAGE2_EDIT_ENDPOINT=https://provider.example.com/custom/edits
